# Copy this file to .env and fill in real values.

# --- App ---
APP_ENV=development
# Signs the session cookie. The app refuses to start with APP_ENV=production
# while this is still "changeme". Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=changeme

# --- Spotify OAuth (authorization code flow) ---
# Redirect URI must use 127.0.0.1, not localhost. It goes through the Vite
# dev server's /api proxy so the app and API share one origin, like
# CloudFront in production (https://<id>.cloudfront.net/api/auth/callback).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/api/auth/callback
# Where to send the browser after a successful login — the Vite dev server.
FRONTEND_URL=http://127.0.0.1:5173

# --- Database ---
# Run `docker compose up -d` to start Postgres locally with these credentials.
DATABASE_URL=postgresql+asyncpg://vibesplit:vibesplit@localhost:5433/vibesplit

# --- Cache / job queue backing ---
REDIS_URL=redis://localhost:6379/0

# --- LLM API (genre/vibe tagging, cluster labeling + outlier detection) ---
# Free tier, no credit card — get a key at https://console.groq.com/keys
# Switched from Gemini: same "avoid a paid dependency" reasoning, but
# Groq's free daily request cap is roughly 50x higher, and its rate
# limits are per-organization rather than shared across every free-tier
# user of a given model (which is what made Gemini's occasional "model
# experiencing high demand" 503s unfixable by anything on our end).
GROQ_API_KEY=

# --- Last.fm (artist genre tags, optional) ---
LASTFM_API_KEY=
