{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-dev",
      "url": "http://127.0.0.1:5173"
    },
    {
      "name": "frontend-vite",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--host", "127.0.0.1"],
      "port": 5173
    },
    {
      "name": "api",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": ["app.main:app", "--host", "127.0.0.1", "--port", "8000", "--reload"],
      "port": 8000
    },
    {
      "name": "worker",
      "runtimeExecutable": ".venv/bin/arq",
      "runtimeArgs": ["app.worker.WorkerSettings"]
    }
  ]
}
